{
  "name": "kasir-db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "if [ -f index.html.src ]; then cp index.html.src index.html; fi && vite",
    "build": "if [ -f index.html.src ]; then cp index.html.src index.html; fi && cp index.html index.html.src && vite build && cp dist/index.html index.html && ln -sf dist/assets assets",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/gemini-cli": "^0.52.0",
    "@supabase/supabase-js": "^2.110.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
